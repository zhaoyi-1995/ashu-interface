{
  "$schema": "https://json.schemastore.org/swcrc",  // 这是一个 JSON Schema，用于验证配置文件的格式和内容。

  "module": {
    "type": "es6",  // 指定模块系统类型为 ES6 模块，启用 `import` 和 `export` 语法。
    "ignoreDynamic": true,  // 忽略动态导入（`import()`），这常用于实现代码分割和按需加载。
    "strict": true,  // 启用严格模式，确保代码按严格的 ECMAScript 规则进行解析。
    "strictMode": true,  // 强制启用严格模式，禁止某些不推荐的语法特性。
    "laze": true,  // 启用懒加载模式，优化代码加载过程，只有在需要时才加载代码。
    "noInterop": true  // 禁用 ES6 模块和 CommonJS 模块之间的互操作性，这对于某些特定的模块加载机制是有用的。
  },

  "jsc": {
    "parser": {
      "syntax": "typescript",  // 设置解析器为 TypeScript，允许解析 TypeScript 代码。
      "dynamicImport": true,  // 启用动态导入，允许使用 `import()` 来按需加载模块。
      "decorators": true,  // 启用装饰器，支持 TypeScript 或 JavaScript 中的装饰器语法。
      "tsx": true  // 启用 TSX 语法，允许解析包含 JSX 语法的 TypeScript 文件（常用于 React）。
    },
    "transform": {
      "legacyDecorator": true,  // 支持旧版本的装饰器语法，兼容一些较老的装饰器规范。
      "decoratorMetadata": true,  // 启用装饰器元数据生成，通常和 TypeScript 一起使用，方便一些元数据的处理。
      "react": {
        "runtime": "automatic",  // 启用 React 17+ 自动 JSX 转换，无需手动导入 React。
        "refresh": true,  // 启用 React 热重载（用于开发过程中，能在不重新加载页面的情况下更新 UI）。
        "development": false,  // 禁用 React 的开发模式特性，通常在生产环境中启用以提高性能。
        "pragma": "React.createElement",  // 指定 JSX 的编译方法，通常是 `React.createElement`。
        "pragmaFrag": "React.Fragment"  // 指定 JSX 中 `Fragment` 的编译方法。
      }
    },
    "target": "es2022",  // 设置编译后的目标 ECMAScript 版本为 ES2022，生成的代码支持 ES2022 特性。
    "loose": true,  // 启用宽松模式，允许生成某些不完全符合 ECMAScript 规范的代码，以提高性能。
    "externalHelpers": true,  // 启用外部辅助函数，帮助将常用的辅助代码（如 Babel 的辅助函数）提取到外部文件，从而减少输出文件的大小。
    "keepClassNames": true  // 保留类名（例如，类名不会被压缩），通常在开发时有用，以便进行调试。
  },

  "minify": true,  // 启用代码压缩，减少最终输出文件的体积。
  "sourceMaps": true,  // 启用源映射，允许在开发时调试源代码，而不是压缩后的代码。
  "exclude": ["node_modules", ".git", "dist"]  // 排除某些目录（如 `node_modules`、`.git` 和 `dist`）在编译过程中的文件，避免不必要的文件被处理。
}
